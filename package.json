{
  "name": "@ostro/cookie",
  "version": "1.0.2",
  "description": "Cookie module for OstroJS",
  "main": "build/jar.js",
  "scripts": {
    "test": "npx c8 npx jest",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ostro/contracts": "^1.0.0",
    "@ostro/support": "^1.0.2",
    "cookie": "^0.4.0",
    "cookie-signature": "^1.1.0",
    "lodash.get": "^4.4.2",
    "lodash.set": "^4.3.2"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "engineStrict": true,
  "keywords": [
    "cookie"
  ],
  "author": "amar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ostrojs/cookie.git"
  },
  "bugs": {
    "url": "https://github.com/ostrojs/cookie/issues"
  },
  "homepage": "https://github.com/ostrojs/cookie#readme",
  "types": "build/jar.d.ts",
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "types": "./build/jar.d.ts",
      "default": "./build/jar.js"
    },
    "./*": {
      "types": "./build/*.d.ts",
      "default": "./build/*.js"
    }
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0"
  }
}
